#!/usr/bin/env python3
"""Universal Linux EC/ACPI battery latch & 0W recovery tool for ThinkPad laptops."""

import argparse
import glob
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time

POWER_SUPPLY_DIR = "/sys/class/power_supply"
BACKLIGHT_DIR = "/sys/class/backlight"
POWERCAP_DIR = "/sys/class/powercap"
KMOD_NAME = "thinkpad_battery_fix_kmod"
KMOD_PARAMS_DIR = f"/sys/module/{KMOD_NAME}/parameters"
DEFAULT_ALARM_FALLBACK = 2553000
DRIVER_CANDIDATES = (
    "/sys/bus/platform/drivers/acpi-battery",
    "/sys/bus/platform/drivers/battery",
    "/sys/bus/acpi/drivers/battery",
)

POLL_INTERVAL = 10.0
LATCH_POLL_INTERVAL = 2.0
MIN_STREAK_GAP = 4.0
STAGE1_COOLDOWN = 120.0
STAGE2_INTERVAL = 30.0
UPOWER_SYNC_INTERVAL = 15.0

RAW_STATUS_MAP = {
    0: "Unknown",
    1: "Charging",
    2: "Discharging",
    3: "Not charging",
    4: "Full",
}

_BAT_RE = re.compile(r"^BAT\d+$")
_wake_event = threading.Event()
_stop_event = threading.Event()


def log(msg):
    """Print log line with flush for journal / syslog visibility."""
    print(f"[thinkpad-battery-fix] {msg}", flush=True)


def clamp(val, low, high):
    """Clamp numeric value to [low, high]."""
    return max(low, min(high, val))


def read_text(path, default=None):
    """Read stripped text from a sysfs/proc path."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=None):
    """Read integer from a sysfs path."""
    val = read_text(path)
    if val is None:
        return default
    try:
        return int(val)
    except ValueError:
        return default


def read_sysfs(bat_path, attr, default=None):
    """Read a stripped sysfs attribute from a power_supply device."""
    return read_text(os.path.join(bat_path, attr), default)


def read_sysfs_int(bat_path, attr, default=None):
    """Read an integer sysfs attribute from a power_supply device."""
    return read_int(os.path.join(bat_path, attr), default)


def write_sysfs(path, value):
    """Write a string value to a sysfs path."""
    with open(path, "w", encoding="utf-8") as f:
        f.write(str(value))


def kmod_is_loaded():
    """Return True if thinkpad_battery_fix_kmod parameters are present in sysfs."""
    return os.path.isdir(KMOD_PARAMS_DIR)


def ensure_kmod_loaded():
    """Load thinkpad_battery_fix_kmod via modprobe if available and not yet loaded."""
    if kmod_is_loaded():
        return True
    if os.geteuid() != 0:
        return False
    modprobe = shutil.which("modprobe")
    if not modprobe:
        return False
    try:
        res = subprocess.run(
            [modprobe, KMOD_NAME],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        if res.returncode == 0 and kmod_is_loaded():
            log(f"Loaded kernel module {KMOD_NAME}")
            return True
    except (OSError, subprocess.SubprocessError):
        pass
    return False


def read_kmod_param_int(name, default=None):
    """Read an integer module parameter from thinkpad_battery_fix_kmod."""
    return read_int(os.path.join(KMOD_PARAMS_DIR, name), default)


def write_kmod_param(name, value):
    """Write a value to a writable thinkpad_battery_fix_kmod parameter."""
    path = os.path.join(KMOD_PARAMS_DIR, name)
    if not os.path.exists(path):
        return False
    try:
        write_sysfs(path, str(int(value)))
        return True
    except (OSError, ValueError):
        return False


def clear_kmod_overrides():
    """Reset all writable kernel override parameters back to passthrough mode."""
    if not kmod_is_loaded():
        return
    write_kmod_param("mask_not_charging", 0)
    write_kmod_param("override_power_uw", 0)
    write_kmod_param("override_energy_uwh", 0)


def read_raw_status(bat_path):
    """Read unmodified hardware status using kmod raw_status when active."""
    eff_status = read_sysfs(bat_path, "status", "Unknown")
    if kmod_is_loaded():
        raw_st = read_kmod_param_int("raw_status")
        if raw_st in RAW_STATUS_MAP:
            return RAW_STATUS_MAP[raw_st]
    return eff_status


def discover_batteries(selected=None):
    """Discover system ACPI batteries (e.g. BAT0, BAT1) across Linux distros."""
    if selected:
        return [selected]

    if not os.path.isdir(POWER_SUPPLY_DIR):
        return ["BAT0"]

    found = []
    for entry in sorted(os.listdir(POWER_SUPPLY_DIR)):
        if not _BAT_RE.match(entry):
            continue
        bat_path = os.path.join(POWER_SUPPLY_DIR, entry)
        scope = read_sysfs(bat_path, "scope")
        if scope and scope.lower() == "device":
            continue
        found.append(entry)

    return found or ["BAT0"]


def resolve_battery_driver(bat_name):
    """Dynamically resolve (driver_dir, dev_name) for a battery across kernel versions."""
    bat_path = os.path.join(POWER_SUPPLY_DIR, bat_name)
    for node_rel in ("device/physical_node", "device"):
        node_link = os.path.join(bat_path, node_rel)
        driver_link = os.path.join(node_link, "driver")
        if os.path.exists(driver_link):
            driver_dir = os.path.realpath(driver_link)
            dev_name = os.path.basename(os.path.realpath(node_link))
            if os.path.exists(os.path.join(driver_dir, "bind")) and os.path.exists(
                os.path.join(driver_dir, "unbind")
            ):
                return driver_dir, dev_name

    # Fallback when BATx is temporarily unbound: match BATx index to PNP0C0A:XX.
    m = re.search(r"(\d+)$", bat_name)
    idx = int(m.group(1)) if m else 0
    for cand in DRIVER_CANDIDATES:
        if not (
            os.path.exists(os.path.join(cand, "bind"))
            and os.path.exists(os.path.join(cand, "unbind"))
        ):
            continue
        entries = sorted(e for e in os.listdir(cand) if e.startswith("PNP0C0A:"))
        for entry in entries:
            ps_dir = os.path.join(cand, entry, "power_supply")
            if os.path.isdir(ps_dir) and bat_name in os.listdir(ps_dir):
                return cand, entry
        if idx < len(entries):
            return cand, entries[idx]
        if entries:
            return cand, entries[0]
        return cand, f"PNP0C0A:{idx:02d}"

    return None, None


def get_battery_snapshot(bat_name):
    """Collect effective sysfs metrics plus raw kmod hardware values when hooked."""
    bat_path = os.path.join(POWER_SUPPLY_DIR, bat_name)
    present = os.path.exists(os.path.join(bat_path, "status"))
    if not present:
        return {"name": bat_name, "path": bat_path, "present": False}

    # Reading these sysfs attributes first populates kmod raw_* parameters for this poll.
    status = read_sysfs(bat_path, "status", "Unknown")
    capacity = read_sysfs_int(bat_path, "capacity")
    capacity_level = read_sysfs(bat_path, "capacity_level")
    voltage_now = read_sysfs_int(bat_path, "voltage_now")

    if os.path.exists(os.path.join(bat_path, "energy_now")) or os.path.exists(
        os.path.join(bat_path, "energy_full")
    ):
        unit = "energy"
        level_now = read_sysfs_int(bat_path, "energy_now")
        level_full = read_sysfs_int(bat_path, "energy_full")
        rate_now = read_sysfs_int(bat_path, "power_now")
    else:
        unit = "charge"
        level_now = read_sysfs_int(bat_path, "charge_now")
        level_full = read_sysfs_int(bat_path, "charge_full")
        rate_now = read_sysfs_int(bat_path, "current_now")

    raw_status_str = status
    raw_level_now = level_now
    raw_rate_now = rate_now
    if kmod_is_loaded():
        raw_st = read_kmod_param_int("raw_status")
        if raw_st in RAW_STATUS_MAP:
            raw_status_str = RAW_STATUS_MAP[raw_st]
        if unit == "energy":
            raw_p = read_kmod_param_int("raw_power_uw")
            if raw_p is not None:
                raw_rate_now = raw_p
        raw_e = read_kmod_param_int("raw_energy_uwh")
        if raw_e is not None:
            raw_level_now = raw_e

    return {
        "name": bat_name,
        "path": bat_path,
        "present": True,
        "unit": unit,
        "status": status,
        "raw_status": raw_status_str,
        "capacity": capacity,
        "capacity_level": capacity_level,
        "level_now": level_now,
        "raw_level_now": raw_level_now,
        "level_full": level_full,
        "voltage_now": voltage_now,
        "rate_now": rate_now,
        "raw_rate_now": raw_rate_now,
        "alarm": read_sysfs_int(bat_path, "alarm"),
        "charge_behaviour": read_sysfs(bat_path, "charge_behaviour"),
    }


def compute_default_alarm(level_full):
    """Compute standard 5% alarm threshold in sysfs native units (uWh or uAh)."""
    if level_full and level_full > 0:
        return max(100000, level_full // 20)
    return DEFAULT_ALARM_FALLBACK


def is_zero_power_latch(snap):
    """Detect whether the battery is exhibiting the 0W active charge/discharge anomaly."""
    if not snap.get("present"):
        return False
    return (
        snap.get("raw_status") in ("Charging", "Discharging")
        and snap.get("raw_rate_now") == 0
    )


class SamplePowerEstimator:
    """Estimate live system power load via Intel RAPL + backlight, plus USB-C PD input."""

    def __init__(self):
        self.pkg_dir, self.pkg_max = self._find_rapl_zone("package-0", "intel-rapl:0")
        self.dram_dir, self.dram_max = self._find_rapl_zone("dram", "intel-rapl:0:2")
        self.prev_ts = None
        self.prev_pkg_uj = None
        self.prev_dram_uj = None
        self.avg_sys_load_uw = None

    @staticmethod
    def _find_rapl_zone(target_name, fallback_rel):
        for candidate in sorted(glob.glob(os.path.join(POWERCAP_DIR, "intel-rapl:*"))):
            if read_text(os.path.join(candidate, "name")) == target_name:
                max_r = read_int(os.path.join(candidate, "max_energy_range_uj"), 0)
                return candidate, max_r
        fb = os.path.join(POWERCAP_DIR, fallback_rel)
        if os.path.isdir(fb):
            return fb, read_int(os.path.join(fb, "max_energy_range_uj"), 0)
        return None, 0

    @staticmethod
    def _energy_delta(cur, prev, max_range):
        if cur is None or prev is None:
            return 0
        if cur >= prev:
            return cur - prev
        if max_range and max_range > prev:
            return (max_range - prev) + cur
        return 0

    @staticmethod
    def _read_backlight_fraction():
        for bl_dir in sorted(glob.glob(os.path.join(BACKLIGHT_DIR, "*"))):
            cur_b = read_int(os.path.join(bl_dir, "brightness"))
            max_b = read_int(os.path.join(bl_dir, "max_brightness"))
            if cur_b is not None and max_b and max_b > 0:
                return clamp(cur_b / float(max_b), 0.0, 1.0)
        return 0.5

    @staticmethod
    def read_usbc_input_uw():
        """Return negotiated USB-C PD power in uW if online, else None."""
        total_uw = 0
        any_online = False
        for psy_dir in sorted(glob.glob(os.path.join(POWER_SUPPLY_DIR, "ucsi-source-psy-*"))):
            if read_text(os.path.join(psy_dir, "online")) != "1":
                continue
            v_uv = read_int(os.path.join(psy_dir, "voltage_now"), 0)
            i_ua = read_int(os.path.join(psy_dir, "current_now"), 0)
            if v_uv > 0 and i_ua > 0:
                total_uw += (v_uv * i_ua) // 1000000
                any_online = True
        return total_uw if any_online and total_uw > 0 else None

    def sample_sys_load_uw(self):
        """Sample instantaneous and smoothed system load in uW using RAPL + panel baseline."""
        now = time.monotonic()
        pkg_uj = read_int(os.path.join(self.pkg_dir, "energy_uj")) if self.pkg_dir else None
        dram_uj = read_int(os.path.join(self.dram_dir, "energy_uj")) if self.dram_dir else None
        bright_frac = self._read_backlight_fraction()
        base_uw = 3200000 + int(2200000 * bright_frac)

        pkg_uw = 2000000
        dram_uw = 500000
        if self.prev_ts is not None and (now - self.prev_ts) >= 0.2:
            dt = now - self.prev_ts
            if pkg_uj is not None and self.prev_pkg_uj is not None:
                d_pkg = self._energy_delta(pkg_uj, self.prev_pkg_uj, self.pkg_max)
                pkg_uw = clamp(int(d_pkg / dt), 200000, 45000000)
            if dram_uj is not None and self.prev_dram_uj is not None:
                d_dram = self._energy_delta(dram_uj, self.prev_dram_uj, self.dram_max)
                dram_uw = clamp(int(d_dram / dt), 100000, 15000000)

        self.prev_ts = now
        self.prev_pkg_uj = pkg_uj
        self.prev_dram_uj = dram_uj

        sys_load_uw = pkg_uw + dram_uw + base_uw
        if self.avg_sys_load_uw is None:
            self.avg_sys_load_uw = sys_load_uw
        else:
            self.avg_sys_load_uw = int(0.25 * sys_load_uw + 0.75 * self.avg_sys_load_uw)
        return sys_load_uw, self.avg_sys_load_uw


def kick_btp(snap):
    """Invoke ACPI _BTP (AJTP) via BATx/alarm to advance HT0L/HT0H and re-arm HAM4."""
    bat_name = snap["name"]
    bat_path = snap["path"]
    raw_st = snap.get("raw_status") or snap.get("status")
    default_alarm = compute_default_alarm(snap.get("level_full"))
    alarm_path = os.path.join(bat_path, "alarm")

    if not os.path.exists(alarm_path):
        return False

    try:
        if raw_st == "Charging":
            write_sysfs(alarm_path, "0")
            time.sleep(0.05)
            write_sysfs(alarm_path, str(default_alarm))
            log(f"[{bat_name}] _BTP kick (Charging): wrote 0 -> {default_alarm} to alarm")
            return True

        if raw_st == "Discharging":
            target = snap.get("level_full") or 51060000
            write_sysfs(alarm_path, str(target))
            time.sleep(0.15)
            write_sysfs(alarm_path, str(default_alarm))
            log(f"[{bat_name}] _BTP kick (Discharging): wrote {target} -> {default_alarm} to alarm")
            return True

        write_sysfs(alarm_path, str(default_alarm))
        return True
    except OSError as exc:
        log(f"[{bat_name}] Warning: failed to write {alarm_path}: {exc}")
        return False


def pulse_ec_smbus_refresh(snap):
    """Toggle charge_behaviour (inhibit-charge -> auto) while masking transient Not charging."""
    bat_name = snap["name"]
    bat_path = snap["path"]
    behav_path = os.path.join(bat_path, "charge_behaviour")
    behav = snap.get("charge_behaviour")

    if (snap.get("raw_status") or snap.get("status")) != "Charging":
        return False
    if not behav or "[auto]" not in behav or "inhibit-charge" not in behav:
        return False
    if not os.path.exists(behav_path):
        return False

    before_l = snap.get("raw_level_now") or snap.get("level_now")
    before_v = snap.get("voltage_now")

    write_kmod_param("mask_not_charging", 1)
    try:
        try:
            write_sysfs(behav_path, "inhibit-charge")
        except OSError as exc:
            log(f"[{bat_name}] Warning: failed writing inhibit-charge: {exc}")
            return False

        # Wait ~0.6s..1.2s for EC HB0S bit 0x20 to clear and SMBus registers to flush.
        deadline = time.monotonic() + 1.2
        time.sleep(0.6)
        while time.monotonic() < deadline:
            if read_raw_status(bat_path) != "Charging":
                break
            time.sleep(0.15)

        try:
            write_sysfs(behav_path, "auto")
        except OSError as exc:
            log(f"[{bat_name}] Error: failed restoring auto charge_behaviour: {exc}")
            return False

        # Wait up to 6.0s for raw EC HB0S/status to return from Not charging.
        settle_deadline = time.monotonic() + 6.0
        cur_raw = None
        while time.monotonic() < settle_deadline:
            cur_raw = read_raw_status(bat_path)
            if cur_raw in ("Charging", "Discharging", "Full"):
                break
            time.sleep(0.25)

        if cur_raw in ("Charging", "Discharging", "Full"):
            time.sleep(0.25)
    finally:
        write_kmod_param("mask_not_charging", 0)

    after = get_battery_snapshot(bat_name)
    log(
        f"[{bat_name}] EC SMBus pulse (inhibit-charge -> auto): "
        f"level {before_l} -> {after.get('raw_level_now')}, "
        f"cap={after.get('capacity')}%, volt {before_v} -> {after.get('voltage_now')} uV, "
        f"raw_status={after.get('raw_status')}"
    )
    return True


def rebind_battery_driver(bat_name, cached_driver=None):
    """Manually unbind and rebind PNP0C0A:XX when explicitly requested via --rebind."""
    bat_path = os.path.join(POWER_SUPPLY_DIR, bat_name)
    driver_dir, dev_name = resolve_battery_driver(bat_name)
    if (not driver_dir or not dev_name) and cached_driver:
        driver_dir, dev_name = cached_driver

    if not driver_dir or not dev_name:
        log(f"[{bat_name}] Error: could not resolve ACPI battery driver path for rebind")
        return False

    unbind_path = os.path.join(driver_dir, "unbind")
    bind_path = os.path.join(driver_dir, "bind")
    bound_dev_path = os.path.join(driver_dir, dev_name)

    log(f"[{bat_name}] Rebinding {dev_name} via {driver_dir}")
    try:
        if os.path.exists(bound_dev_path):
            write_sysfs(unbind_path, dev_name)
            time.sleep(0.2)
    except OSError as exc:
        log(f"[{bat_name}] Warning: unbind {dev_name} failed: {exc}")

    try:
        write_sysfs(bind_path, dev_name)
    except OSError as exc:
        log(f"[{bat_name}] Error: bind {dev_name} failed: {exc}")
        return False

    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline:
        if os.path.exists(os.path.join(bat_path, "status")):
            break
        time.sleep(0.1)

    for attr in ("charge_behaviour", "energy_now", "charge_now", "voltage_now", "power_now", "current_now"):
        read_sysfs(bat_path, attr)
    return os.path.exists(os.path.join(bat_path, "status"))


def upower_refresh(bat_name):
    """Trigger a kernel power_supply change uevent so upowerd re-reads sysfs immediately."""
    uevent_path = os.path.join(POWER_SUPPLY_DIR, bat_name, "uevent")
    if not os.path.exists(uevent_path):
        return False
    try:
        write_sysfs(uevent_path, "change\n")
        return True
    except OSError as exc:
        log(f"[{bat_name}] Note: failed writing change to {uevent_path}: {exc}")
        return False


def _run_service_cmd(cmd):
    """Execute a service management command and return True on zero exit code."""
    try:
        res = subprocess.run(
            cmd, capture_output=True, text=True, timeout=15, check=False
        )
        return res.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def restart_upower_and_refresh(bat_name):
    """Restart upowerd (systemd/OpenRC/runit/SysV) to clear 0W latch, then emit uevent."""
    log(f"[{bat_name}] Restarting upowerd to reset has_energy_rate_from_hw latch")
    restarted = False

    if os.path.isdir("/run/systemd/system") and shutil.which("systemctl"):
        restarted = _run_service_cmd(["systemctl", "restart", "upower.service"])
    elif shutil.which("rc-service"):
        restarted = _run_service_cmd(["rc-service", "upowerd", "restart"]) or _run_service_cmd(
            ["rc-service", "upower", "restart"]
        )
    elif shutil.which("sv"):
        for sv_dir in ("/var/service/upowerd", "/run/runit/service/upowerd", "/etc/sv/upowerd"):
            if os.path.exists(sv_dir):
                restarted = _run_service_cmd(["sv", "restart", sv_dir])
                if restarted:
                    break
    elif shutil.which("service"):
        restarted = _run_service_cmd(["service", "upower", "restart"]) or _run_service_cmd(
            ["service", "upowerd", "restart"]
        )

    if not restarted and shutil.which("pkill"):
        _run_service_cmd(["pkill", "-TERM", "-x", "upowerd"])
        restarted = True

    if not restarted:
        log(f"[{bat_name}] Warning: could not restart upowerd automatically")
        return False

    time.sleep(0.6)
    return upower_refresh(bat_name)


def cmd_status(args):
    """Print detailed battery sysfs metrics, kmod state, and anomaly status."""
    batteries = discover_batteries(args.battery)
    kmod_ok = kmod_is_loaded()
    rc = 0
    for idx, bat_name in enumerate(batteries):
        if idx > 0:
            print("---")
        snap = get_battery_snapshot(bat_name)
        driver_dir, dev_name = resolve_battery_driver(bat_name)

        if not snap.get("present"):
            print(f"[{bat_name}] not present")
            print(f"ACPI driver     : {driver_dir or 'not found'} ({dev_name or '?'})")
            print(f"Kernel hook     : {'loaded' if kmod_ok else 'not loaded'}")
            rc = 1
            continue

        unit = snap["unit"]
        level_lbl = "energy" if unit == "energy" else "charge"
        level_unit_raw = "uWh" if unit == "energy" else "uAh"
        level_unit_disp = "Wh" if unit == "energy" else "Ah"
        rate_lbl = "power_now" if unit == "energy" else "current_now"
        rate_unit_raw = "uW" if unit == "energy" else "uA"
        rate_unit_disp = "W" if unit == "energy" else "A"

        l_now = snap["level_now"]
        l_full = snap["level_full"]
        v_now = snap["voltage_now"]
        r_now = snap["rate_now"]
        raw_r = snap["raw_rate_now"]
        latch = is_zero_power_latch(snap)

        l_now_str = f"{l_now} {level_unit_raw} ({l_now / 1e6:.2f} {level_unit_disp})" if l_now is not None else "n/a"
        l_full_str = f"{l_full} {level_unit_raw} ({l_full / 1e6:.2f} {level_unit_disp})" if l_full is not None else "n/a"
        v_str = f"{v_now} uV ({v_now / 1e6:.3f} V)" if v_now is not None else "n/a"
        r_str = f"{r_now} {rate_unit_raw} ({r_now / 1e6:.3f} {rate_unit_disp})" if r_now is not None else "n/a"
        raw_r_str = f"{raw_r} uW ({raw_r / 1e6:.3f} W)" if raw_r is not None else "n/a"

        print(f"Battery         : {bat_name}")
        print(f"ACPI driver     : {driver_dir} ({dev_name})")
        print(f"Kernel hook     : {'loaded' if kmod_ok else 'not loaded'}")
        print(f"status          : {snap['status']} (raw: {snap['raw_status']})")
        print(f"capacity        : {snap['capacity']}% (level: {snap['capacity_level']})")
        print(f"{level_lbl}_now      : {l_now_str}")
        print(f"{level_lbl}_full     : {l_full_str}")
        print(f"voltage_now     : {v_str}")
        print(f"{rate_lbl:<16}: {r_str}")
        if kmod_ok:
            print(f"raw_power_uw    : {raw_r_str}")
        print(f"alarm           : {snap['alarm']} {level_unit_raw}" if snap["alarm"] is not None else "alarm           : n/a")
        print(f"charge_behaviour: {snap['charge_behaviour'] or 'n/a'}")

        if latch:
            tag = "7% EDV2 + 0W latch" if snap["capacity"] == 7 else "0W latch"
            hook_note = " [kmod active]" if kmod_ok else " [kmod inactive]"
            print(f"Anomaly active  : YES ({tag}){hook_note}")
        else:
            print("Anomaly active  : NO (normal operation)")

    return rc


def cmd_recover(args):
    """Execute one-shot hot recovery (_BTP kick, EC SMBus pulse, optional --rebind, UPower refresh)."""
    if os.geteuid() != 0:
        log("Error: 'recover' requires root privileges (use sudo or pkexec).")
        return 1

    ensure_kmod_loaded()
    batteries = discover_batteries(args.battery)
    restarted_upower = False

    for bat_name in batteries:
        snap = get_battery_snapshot(bat_name)
        if not snap.get("present"):
            log(f"[{bat_name}] not present; attempting ACPI driver rebind.")
            rebind_battery_driver(bat_name)
            snap = get_battery_snapshot(bat_name)

        initial_latch = is_zero_power_latch(snap)

        if snap.get("present"):
            kick_btp(snap)
            pulse_ec_smbus_refresh(snap)
            snap = get_battery_snapshot(bat_name)

        if args.rebind:
            rebind_battery_driver(bat_name)
            snap = get_battery_snapshot(bat_name)

        if (initial_latch or is_zero_power_latch(snap) or args.rebind) and not restarted_upower:
            restart_upower_and_refresh(bat_name)
            restarted_upower = True
        else:
            upower_refresh(bat_name)

    return cmd_status(args)


def _handle_sigusr1(_signum, _frame):
    _wake_event.set()


def _handle_stop(_signum, _frame):
    _stop_event.set()
    _wake_event.set()


def _init_battery_state(bat_name):
    return {
        "cached_driver": resolve_battery_driver(bat_name),
        "estimator": SamplePowerEstimator(),
        "latch_active": False,
        "zero_power_streak": 0,
        "not_charging_streak": 0,
        "episode_recovered": False,
        "pending_upower_sync": False,
        "last_streak_time": 0.0,
        "last_not_charging_time": 0.0,
        "last_pulse_time": 0.0,
        "last_stage1_time": -STAGE1_COOLDOWN,
        "last_stage2_time": 0.0,
        "last_raw_status": None,
        "last_raw_level": None,
        "last_raw_level_time": 0.0,
        "base_charge_uw": 15500000,
        "virtual_energy_uwh": None,
        "last_discharge_ts": 0.0,
        "last_upower_sync_time": 0.0,
        "last_upower_power_uw": 0,
    }


def _compute_charge_uw_from_delta(snap, d_level, dt):
    """Convert raw sysfs energy/charge delta over dt seconds into uW."""
    if snap.get("unit") == "charge":
        v_uv = snap.get("voltage_now") or 11100000
        d_uwh = (d_level * v_uv) / 1000000.0
    else:
        d_uwh = float(d_level)
    return clamp(int((d_uwh * 3600.0) / dt), 2000000, 65000000)


def _update_kmod_charging(bat_name, state, snap, now):
    """Track dE/dt + RAPL modulation and update kmod override parameters while Charging."""
    est = state["estimator"]
    sys_load_uw, avg_load_uw = est.sample_sys_load_uw()
    raw_level = snap.get("raw_level_now")

    if raw_level is not None:
        prev_level = state["last_raw_level"]
        if prev_level is None:
            state["last_raw_level"] = raw_level
            state["last_raw_level_time"] = now
        elif raw_level > prev_level:
            dt = now - state["last_raw_level_time"]
            if dt >= 5.0:
                measured_uw = _compute_charge_uw_from_delta(snap, raw_level - prev_level, dt)
                state["base_charge_uw"] = int(0.6 * measured_uw + 0.4 * state["base_charge_uw"])
            state["last_raw_level"] = raw_level
            state["last_raw_level_time"] = now
        elif raw_level < prev_level:
            state["last_raw_level"] = raw_level
            state["last_raw_level_time"] = now

    mod_uw = clamp(
        int(state["base_charge_uw"] - (sys_load_uw - avg_load_uw)),
        2000000,
        65000000,
    )
    write_kmod_param("override_power_uw", mod_uw)
    write_kmod_param("override_energy_uwh", 0)
    state["virtual_energy_uwh"] = None
    state["last_discharge_ts"] = 0.0
    return mod_uw


def _update_kmod_discharging(bat_name, state, snap, now):
    """Track RAPL load + virtual coulomb counter when EC latches 0W while Discharging."""
    est = state["estimator"]
    sys_load_uw, _ = est.sample_sys_load_uw()
    discharge_uw = clamp(int(sys_load_uw), 2500000, 65000000)

    write_kmod_param("mask_not_charging", 0)
    write_kmod_param("override_power_uw", discharge_uw)

    raw_level = snap.get("raw_level_now")
    level_full = snap.get("level_full") or 50230000
    min_floor = int(level_full * 0.07)

    if state["virtual_energy_uwh"] is None or state["last_discharge_ts"] == 0.0:
        state["virtual_energy_uwh"] = raw_level if raw_level is not None else min_floor
        state["last_raw_level"] = raw_level
    else:
        if raw_level is not None and raw_level != state["last_raw_level"]:
            state["virtual_energy_uwh"] = raw_level
            state["last_raw_level"] = raw_level
        else:
            dt = max(0.0, min(30.0, now - state["last_discharge_ts"]))
            if snap.get("unit") == "charge":
                v_uv = snap.get("voltage_now") or 11100000
                delta = int((discharge_uw * dt / 3600.0) * (1000000.0 / v_uv))
            else:
                delta = int(discharge_uw * dt / 3600.0)
            state["virtual_energy_uwh"] = max(min_floor, state["virtual_energy_uwh"] - delta)

    state["last_discharge_ts"] = now
    write_kmod_param("override_energy_uwh", state["virtual_energy_uwh"])
    return discharge_uw


def _sync_upower_if_needed(bat_name, state, cur_power_uw, now, force=False):
    """Emit batched sysfs uevent changes so UPower updates without spamming its 10s gate."""
    if not kmod_is_loaded():
        return False
    elapsed = now - state["last_upower_sync_time"]
    if not force:
        if elapsed < UPOWER_SYNC_INTERVAL and (
            elapsed < 10.5 or abs(cur_power_uw - state["last_upower_power_uw"]) < 1500000
        ):
            return False
    if upower_refresh(bat_name):
        state["last_upower_sync_time"] = now
        state["last_upower_power_uw"] = cur_power_uw
        return True
    return False


def _process_battery_tick(bat_name, state, now):
    snap = get_battery_snapshot(bat_name)
    if not snap.get("present"):
        return False

    resolved = resolve_battery_driver(bat_name)
    if resolved[0] and resolved[1]:
        state["cached_driver"] = resolved

    raw_status = snap.get("raw_status")
    raw_rate = snap.get("raw_rate_now")
    voltage_now = snap.get("voltage_now")
    prev_raw_status = state["last_raw_status"]
    status_changed = prev_raw_status is not None and prev_raw_status != raw_status
    state["last_raw_status"] = raw_status

    emitted_udev = False

    if state["pending_upower_sync"] and raw_status in ("Charging", "Discharging", "Full"):
        emitted_udev = upower_refresh(bat_name) or emitted_udev
        state["pending_upower_sync"] = False

    if is_zero_power_latch(snap):
        state["latch_active"] = True
        state["not_charging_streak"] = 0

        if raw_status == "Charging":
            cur_pw = _update_kmod_charging(bat_name, state, snap, now)
        else:
            cur_pw = _update_kmod_discharging(bat_name, state, snap, now)

        if not state["episode_recovered"]:
            if now - state["last_streak_time"] >= MIN_STREAK_GAP:
                state["zero_power_streak"] += 1
                state["last_streak_time"] = now
                if state["zero_power_streak"] <= 2:
                    log(
                        f"[{bat_name}] Detected 0W while {raw_status} (cap={snap.get('capacity')}%, "
                        f"volt={voltage_now} uV, streak={state['zero_power_streak']}/2)"
                    )

            if state["zero_power_streak"] >= 2:
                if now - state["last_stage1_time"] >= STAGE1_COOLDOWN:
                    log(f"[{bat_name}] Triggering Stage 1 recovery (_BTP + EC SMBus pulse + upower restart)")
                    kick_btp(snap)
                    pulsed = pulse_ec_smbus_refresh(snap)
                    restart_upower_and_refresh(bat_name)
                    now = time.monotonic()
                    state["episode_recovered"] = True
                    state["last_stage1_time"] = now
                    state["last_stage2_time"] = now
                    state["last_upower_sync_time"] = now
                    state["last_upower_power_uw"] = cur_pw
                    if pulsed:
                        state["last_pulse_time"] = now
                    post = get_battery_snapshot(bat_name)
                    state["pending_upower_sync"] = post.get("raw_status") == "Not charging"
                    return True

                state["episode_recovered"] = True
                state["last_stage2_time"] = now - STAGE2_INTERVAL

        if state["episode_recovered"]:
            did_pulse = False
            if raw_status == "Charging" and (now - state["last_stage2_time"] >= STAGE2_INTERVAL):
                kick_btp(snap)
                pulsed = pulse_ec_smbus_refresh(snap)
                now = time.monotonic()
                state["last_stage2_time"] = now
                if pulsed:
                    state["last_pulse_time"] = now
                post = get_battery_snapshot(bat_name)
                cur_pw = _update_kmod_charging(bat_name, state, post, now)
                if post.get("raw_status") == "Not charging":
                    state["pending_upower_sync"] = True
                else:
                    emitted_udev = _sync_upower_if_needed(bat_name, state, cur_pw, now, force=True) or emitted_udev
                    state["pending_upower_sync"] = False
                did_pulse = True
            elif status_changed:
                if raw_status == "Discharging":
                    kick_btp(snap)
                emitted_udev = _sync_upower_if_needed(bat_name, state, cur_pw, now, force=True) or emitted_udev

            if not did_pulse:
                emitted_udev = _sync_upower_if_needed(bat_name, state, cur_pw, now, force=False) or emitted_udev
    else:
        if (raw_rate is not None and raw_rate > 0) or raw_status == "Full":
            if state["latch_active"] or state["episode_recovered"] or state["zero_power_streak"] > 0:
                log(
                    f"[{bat_name}] Normal battery telemetry restored (status={raw_status}, "
                    f"rate={raw_rate}, cap={snap.get('capacity')}%)"
                )
            clear_kmod_overrides()
            state["latch_active"] = False
            state["zero_power_streak"] = 0
            state["not_charging_streak"] = 0
            state["episode_recovered"] = False
            state["pending_upower_sync"] = False
            state["virtual_energy_uwh"] = None
            state["last_raw_level"] = None
            state["last_discharge_ts"] = 0.0
        elif raw_status == "Not charging":
            clear_kmod_overrides()
            state["latch_active"] = False
            if (now - state["last_pulse_time"] >= 10.0) and (
                now - state["last_not_charging_time"] >= MIN_STREAK_GAP
            ):
                state["not_charging_streak"] += 1
                state["last_not_charging_time"] = now
                if state["not_charging_streak"] >= 2:
                    state["zero_power_streak"] = 0
                    state["episode_recovered"] = False

    return emitted_udev


def cmd_daemon(args):
    """Run event-driven + fast-polling monitor daemon with kernel sysfs telemetry hook."""
    if os.geteuid() != 0:
        log("Error: daemon requires root privileges.")
        return 1

    signal.signal(signal.SIGUSR1, _handle_sigusr1)
    signal.signal(signal.SIGTERM, _handle_stop)
    signal.signal(signal.SIGINT, _handle_stop)

    ensure_kmod_loaded()
    batteries = discover_batteries(args.battery)
    states = {b: _init_battery_state(b) for b in batteries}
    summary = ", ".join(
        f"{b}({s['cached_driver'][0]}:{s['cached_driver'][1]})" for b, s in states.items()
    )
    log(
        f"Daemon started monitoring: {summary} "
        f"[kmod={'loaded' if kmod_is_loaded() else 'not loaded'}]"
    )

    try:
        while not _stop_event.is_set():
            now = time.monotonic()
            any_udev = False
            for bat_name, state in states.items():
                if _process_battery_tick(bat_name, state, now):
                    any_udev = True

            if any_udev:
                time.sleep(0.25)
                _wake_event.clear()

            wait_sec = POLL_INTERVAL
            cur_now = time.monotonic()
            for state in states.values():
                if state["latch_active"] or state["episode_recovered"]:
                    wait_sec = min(wait_sec, LATCH_POLL_INTERVAL)
                    if state["episode_recovered"]:
                        rem = max(0.5, STAGE2_INTERVAL - (cur_now - state["last_stage2_time"]))
                        wait_sec = min(wait_sec, rem)

            _wake_event.wait(timeout=wait_sec)
            _wake_event.clear()
    finally:
        clear_kmod_overrides()

    log("Daemon stopping cleanly")
    return 0


def build_parser():
    """Create CLI argument parser."""
    parser = argparse.ArgumentParser(
        prog="thinkpad-battery-fix",
        description="Fix ThinkPad EC/ACPI 7%/0W battery latch and frozen level on Linux",
    )
    parser.add_argument(
        "-b",
        "--battery",
        help="Target battery device name in /sys/class/power_supply (default: auto-detect all)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_status = sub.add_parser("status", help="Show battery status and detect 0W/7%% latch")
    p_status.set_defaults(func=cmd_status)

    p_recover = sub.add_parser("recover", help="Run hot recovery on battery and UPower")
    p_recover.add_argument(
        "--rebind",
        action="store_true",
        help="Force ACPI battery driver unbind/bind and upowerd restart",
    )
    p_recover.set_defaults(func=cmd_recover)

    p_daemon = sub.add_parser("daemon", help="Run background monitor daemon")
    p_daemon.set_defaults(func=cmd_daemon)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
